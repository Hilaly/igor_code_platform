{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Веб собирается бандлером, а не исполняется Node напрямую, поэтому разрешение
    // модулей здесь другое, чем у демона.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
