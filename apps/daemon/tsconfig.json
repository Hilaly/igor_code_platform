{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["node"]
  },
  "include": ["src"],
  // Плагины-фикстуры — код плагина, а не платформы: им разрешён нестираемый синтаксис (ADR-0004),
  // и проверять их правилами платформы значит запретить ровно то, что они проверяют.
  "exclude": ["src/plugin-fixtures"]
}
